{
    "name": "hasinhayder/tyro-dashboard",
    "description": "Tyro Dashboard - Beautiful admin dashboard for managing Tyro roles, privileges, users, and settings",
    "keywords": [
        "laravel",
        "dashboard",
        "admin",
        "roles",
        "privileges",
        "users",
        "settings",
        "tyro",
        "blade"
    ],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/view": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "hasinhayder/tyro": "^1.5",
        "hasinhayder/tyro-login": "^2.4"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "laravel/pint": "^1.27",
        "nunomaduro/collision": "^8.6 || ^9.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "HasinHayder\\TyroDashboard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HasinHayder\\TyroDashboard\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "HasinHayder\\TyroDashboard\\Providers\\TyroDashboardServiceProvider"
            ]
        }
    },
    "suggest": {
        "mews/purifier": "Required for HTML sanitization"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}